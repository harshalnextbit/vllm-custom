HOST=0.0.0.0
PORT=8006
LOG_LEVEL=info
CORS_ORIGINS=*

# vLLM Engine Configuration
# Leave MODEL_ID empty and AUTO_LOAD_ON_STARTUP=false to boot idle and load via /admin/load-model
MODEL_ID=
MODEL_REVISION=main
QUANTIZATION=none
DTYPE=auto
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.85
ENFORCE_EAGER=False
TENSOR_PARALLEL_SIZE=1
TRUST_REMOTE_CODE=true
HF_TOKEN=
CACHE_DIR=

ENABLE_FALLBACK_TRANSFORMERS_BACKEND=true
ENABLE_PREFIX_CACHING=true
ALLOW_CPU_FALLBACK=false
AUTO_LOAD_ON_STARTUP=false

DEFAULT_MAX_TOKENS=160
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_TOP_K=50
DEFAULT_REPETITION_PENALTY=1.05
DEFAULT_ENABLE_THINKING=false

# Architecture-specific isolated runtimes. Qwen3.6 BF16 passed on vLLM 0.17.0;
# Gemma 4 requires the newer vLLM 0.29.0 runtime and a CUDA 13-compatible driver.
# See scripts/setup_vllm_017_runtime.sh and scripts/setup_vllm_029_runtime.sh.
VLLM_RUNTIME_MAP='{"qwen3.5":"/absolute/path/to/vllm-0.17.0/bin/python","qwen3.5-moe":"/absolute/path/to/vllm-0.17.0/bin/python","sarvam":"/absolute/path/to/vllm-0.17.0-transformers5/bin/python","gemma4":"/absolute/path/to/vllm-0.29.0/bin/python"}'

# Tunnel Configuration: set CLOUDFLARE_TUNNEL_ENABLED=false to run strictly on localhost.
# Leave CLOUDFLARE_TUNNEL_TOKEN empty to automatically use ephemeral Quick Tunnel (trycloudflare.com).
CLOUDFLARE_TUNNEL_ENABLED=true
CLOUDFLARE_TUNNEL_TOKEN=
NGROK_ENABLED=false
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# GitHub Private Repository Settings (Optional - for Colab bootstrap)
GITHUB_TOKEN=
REPO_URL=
